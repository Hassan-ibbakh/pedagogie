# OpenAI-compatible model provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone index must use the embedding model's vector dimension (1536 by default)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
RAG_TOP_K=5

# Upstash Redis conversation persistence (default sliding retention: 7 days)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONVERSATION_TTL_SECONDS=604800